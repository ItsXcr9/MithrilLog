FROM golang:1.23.4 AS builder

WORKDIR /build

# Copy go mod files
COPY go.mod go.sum* ./
RUN go mod tidy && go mod download

# Copy source code (explicitly copy needed directories)
COPY db ./db
COPY scheduler ./scheduler
COPY scheduler-cmd ./scheduler-cmd
COPY config ./config

# Ensure deps are tidy
RUN go mod tidy

# Build the scheduler binary
RUN CGO_ENABLED=1 GOOS=linux go build -o scheduler-bin ./scheduler-cmd

# Final stage
FROM debian:bookworm-slim

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/scheduler-bin ./scheduler

# Run
CMD ["./scheduler"]
