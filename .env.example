# MithrilLog Environment Configuration
# Copy this file to .env and fill in your values

# LLM API Keys (set the one you're using based on llm.backend in config)
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROK_API_KEY=

# ClickHouse Connection (optional - for remote storage)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=6123
CLICKHOUSE_DB=mithrillog
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
