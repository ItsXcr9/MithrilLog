environment: dev
timezone: UTC  # Change to your timezone, e.g. Asia/Tehran

llm:
  # Options: llama_cpp (local GGUF), local (alias), openai, gemini
  backend: gemini
  # Path to GGUF file when using llama_cpp/local backend
  model_path: ./models/llama4-dolphin-8B.Q3_K_M.gguf
  context_length: 8192
  temperature: 0.2
  top_p: 0.9
  max_tokens: 100000
  # Set when backend == openai (ChatGPT-compatible)
  # When left null, OPENAI_API_KEY from .env (if present) is used
  openai_api_key: null
  openai_model: gpt-4o-mini
  openai_base_url: null
  # Set when backend == gemini
  # When left null, GEMINI_API_KEY from .env (if present) is used
  gemini_api_key: null  # Set via GEMINI_API_KEY env var or paste your key here
  gemini_model: gemini-2.5-flash

ingest:
  host: 0.0.0.0
  udp_port: 5514
  tcp_port: 5614
  bucket_dir: ./data/buckets
  max_bucket_minutes: 1
  bloom_error_rate: 0.0001
  reservoir_size: 200
  retention_days: 30
  forward_to_host: null
  forward_to_port: null
  use_python_ingester: false

summary:
  hourly_at_minute: 9
  daily_at_hour: 0
  daily_at_minute: 50
  report_dir: ./data/reports
  # Log levels to analyze with AI (Supported: DEBUG, INFO, WARNING, ERROR, CRITICAL)
  # Default focuses on errors only. Set to all levels to analyze everything
  analysis_levels:
    - DEBUG
    # - INFO
    - WARNING
    - ERROR
    - CRITICAL

storage:
  sqlite_path: ./data/mithrillog.db

prompts:
  hourly: ./prompts/hourly_summary.txt
  daily: ./prompts/daily_summary.txt
  anomaly: ./prompts/anomaly_report.txt
  highlight_analysis: ./prompts/highlight_analysis.txt
  trend: ./prompts/trend_analysis.txt

web:
  title: MithrilLog Console

alert:
  enabled: false  # Set to true and configure telegram below
  telegram_bot_token: ""  # Your Telegram bot token from @BotFather
  telegram_chat_id: ""    # Your Telegram chat/group ID
  error_threshold: 10

cors:
  allowed_origins:
    - "http://localhost:9900"
    - "http://127.0.0.1:9900"
    # Add your production URLs here
    # - "https://logs.yourdomain.com"

logging:
  patterns:
    # Example: Suppress noisy health checks
    # - pattern: "GET /health"
    #   action: SUPPRESS

    # Example: Allow critical errors even if they match other suppression rules
    # - pattern: "CRITICAL FAILURE"
    #   action: ALLOW

    # Example: Reclassify specific errors as warnings
    # - pattern: "connection reset"
    #   action: RECLASSIFY
    #   new_level: WARNING
    #   extra_fields:
    #     type: network_glitch

remote_logging:
  # Send MithrilLog's own application logs to central server for self-monitoring
  enabled: false
  host: localhost  # Your central log server IP
  port: 5515
  protocol: udp  # udp or tcp
